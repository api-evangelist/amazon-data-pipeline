            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds or modifies tags for the specified pipeline."
        },
        {
          "info": {
            "name": "Remove Tags",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://datapipeline.amazonaws.com/?Action=RemoveTags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Removes existing tags from the specified pipeline."
        }
      ]
    }
  ],
  "bundled": true
}