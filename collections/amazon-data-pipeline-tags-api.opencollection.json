{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS Data Pipeline Pipeline Objects Tags API",
    "version": "2012-10-29"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add Tags",
            "type": "http"
          },
          "http": {
